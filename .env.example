# ---------------------------------------------------------------------------
# Riotto World Terminal - environment. Keys stay on the server; the browser never sees them.
# Leave a key blank to disable that adapter (it shows DISABLED in the health matrix).
# ---------------------------------------------------------------------------

HOST=127.0.0.1
PORT=8700
# DB_PATH=./data/macro.db

# Synthetic data ONLY for UI testing. Shows a permanent DEMO banner. Never use for decisions.
DEMO_MODE=false

# FREE - FRED (yields, 2s10s, HY OAS, VIX, FX, WTI/Brent/HH closes, IMF monthly TTF/copper/uranium, OECD 10Y)
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# FREE - EIA API v2 (weekly petroleum status, US stocks/SPR, gas storage, international + STEO production)
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# MARKET PRICES (intraday). Pick one provider: twelvedata | finnhub | polygon
# MARKET_TIER picks the rate-limit budget from config/settings.yaml (e.g. twelvedata_free, twelvedata_paid,
# finnhub_free, polygon_free, polygon_paid). Default = <provider>_free.
# Twelve Data: https://twelvedata.com/pricing   (free: 8 req/min, 800/day; commodities/indices need paid plans)
# Finnhub:     https://finnhub.io/register       (free: 60/min US equities; FX/commodity quotes are premium)
# Polygon:     https://polygon.io/dashboard/signup (free: 5/min, end-of-day only)
MARKET_PROVIDER=
MARKET_TIER=
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=

# FREE for non-commercial use (licence required for commercial use) - ACLED curated conflict events
# https://acleddata.com/register/   (OAuth: your ACLED account email + password)
ACLED_EMAIL=
ACLED_PASSWORD=

# FREE - AISStream.io live AIS (tanker positions in the oil regions of config/ais.yaml)
# https://aisstream.io  (sign in with GitHub, create an API key)
AISSTREAM_API_KEY=

# No key needed: Digitraffic (Finnish Transport Agency AIS, Baltic tankers), World Bank, BIS, JODI, IMF PortWatch, GDELT 2.0, GDACS
